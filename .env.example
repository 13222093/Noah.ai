# Noah AI - environment template.
# Copy to .env.local (dev) or deploy/<stack>.env (VPS). Never commit real values.
# Every value below is a placeholder. Required variables fail closed: the app
# or script refuses to start when one is missing.

# =========================
# Runtime
# =========================
# Synthetic/demo data is allowed only when this is true, and must be labelled
# SIMULASI in the UI (guardrail 5). Production: always false.
NOAH_DEMO_MODE=false
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =========================
# Supabase / Postgres
# =========================
# Public (shipped to browsers by design; protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# Server only. Bypasses RLS. Required by server code; never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# =========================
# ML service (internal network only)
# =========================
ML_API_URL=http://localhost:8000
# Comma-separated origins allowed to call the ML API (read by ml-service settings)
NOAH_CORS_ORIGINS=http://localhost:3000

# =========================
# Store and connector worker (ml-service; docs/data/schema.md, docs/ops/vps-layout.md)
# =========================
# Managed Postgres/PostGIS. Read by ml-api (health), worker (writes) and migrate.
# Worker refuses to start without it; the API then reports health "unconfigured".
NOAH_DATABASE_URL=
# Raw payload storage: local (default, a volume) or s3.
NOAH_OBJECT_STORE=local
NOAH_OBJECT_STORE_DIR=./var/objects
# Only for NOAH_OBJECT_STORE=s3 (credentials via the standard AWS_* variables).
NOAH_S3_BUCKET=
NOAH_S3_PREFIX=
NOAH_S3_ENDPOINT_URL=
NOAH_S3_REGION=
# Sink factory for `python -m noah.connectors run` (compose passes --sink itself).
NOAH_SINK=noah.store.factory:make_sink
# Contact address in the connectors' User-Agent. Set it in every deployment.
NOAH_CONTACT_EMAIL=
# Confirmed endpoints; each connector stays disabled until its URL is set.
NOAH_S4_FEATURE_URL=
NOAH_S5_IMAGE_URL=
# Optional path overrides (defaults resolve in a checkout and in the image).
# NOAH_BASE_DIR=
# NOAH_MIGRATIONS_DIR=
# NOAH_STATIONS_CONFIG=
# Container limits (docker-compose.yml)
NOAH_WEB_MEM=1g
NOAH_ML_MEM=1g
NOAH_WORKER_MEM=512m

# =========================
# Observability (Sentry free tier)
# =========================
# Server/edge runtime
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Browser (must be NEXT_PUBLIC_ to reach the client bundle; inlined at build time)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
# Build-time source map upload only (CI secret, optional)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
