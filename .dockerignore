# Build context for the web image (Dockerfile at repo root).
# Keep secrets, data, docs and other services out of the image (G-104).
# The ml-service image also builds from the repo root but uses its own
# allowlist, ml-service/Dockerfile.dockerignore (BuildKit prefers the ignore
# file next to the Dockerfile), so the exclusions below do not apply to it.

# VCS and CI
.git
.github
.gitignore
.gitleaks.toml
.pre-commit-config.yaml

# Docker
Dockerfile
.dockerignore
docker-compose*.yml

# Dependencies and build output (rebuilt inside the image)
node_modules
**/node_modules
.next
out
build
coverage
*.tsbuildinfo

# Secrets and env files (never in an image)
.env
.env.*
!.env.example
deploy
*.pem
*.key
*.p12

# Other services and tooling
ml-service
supabase
scripts
tests
**/*.test.*
**/*.spec.*

# Docs, agent config, scratch and personal data
docs
documentation
.claude
*.md
CLAUDE.md
KICKOFF_PROMPT.md
Untitled-*.txt
files
files.zip
*.log
eslint-errors.txt
ts-errors.txt
commit_message.txt

# Editors / OS
.vscode
.idea
.DS_Store
Thumbs.db
